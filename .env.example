# Postgres connection string (Neon / Supabase / Vercel Postgres — use the pooled URL).
# When unset, the site falls back to the sample catalog (local dev only).
DATABASE_URL=

# AliExpress Affiliate Open Platform (https://openservice.aliexpress.com)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Optional — defaults: AR / AE / 2 pages (50 products each) per category
ALIEXPRESS_LANGUAGE=AR
ALIEXPRESS_SHIP_TO=AE
ALIEXPRESS_PAGES_PER_CATEGORY=2

# Protects /api/sync. Vercel Cron sends it automatically as "Authorization: Bearer <secret>".
CRON_SECRET=

# Optional — public contact address; enables /contact and the footer link when set
CONTACT_EMAIL=
